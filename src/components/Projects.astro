---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import React from "./icons/React.astro";
import Node from "./icons/Node.astro";
import Css from "./icons/Css.astro";
import JWT from "./icons/JWT.astro";
import Express from "./icons/Express.astro";
import MongoDB from "./icons/MongoDB.astro";
import Vite from "./icons/Vite.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Html from "./icons/Html.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import JavaScript from "./icons/JavaScript.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class:
      "bg-white text-black dark:bg-[#003159] dark:text-white border border-gray-300 dark:border-white/10",
    icon: Tailwind,
  },
  REACT: {
    name: "React",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: React,
  },
  NODE: {
    name: "Node.js",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: Node,
  },
  CSS: {
    name: "CSS3",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: Css,
  },
  JWT: {
    name: "JWT",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: JWT,
  },
  EXPRESS: {
    name: "Express.js",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: Express,
  },
  MongoDB: {
    name: "MongoDB",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: MongoDB,
  },
  VITE: {
    name: "Vite",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: Vite,
  },
  HTML5: {
    name: "HTML5",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: Html,
  },
  ASTRO: {
    name: "ASTRO",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: AstroIcon,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class:
      "bg-white text-black dark:bg-black dark:text-white border border-gray-300 dark:border-white/10",
    icon: JavaScript,
  },
};

const PROJECTS = [
  {
    title: "Providencia Valparaiso",
    description:
      "Desarrollo de un sitio we con Next.js y Tailwind CSS para una hostería en Valparaiso Antioquia. El sitio incluye una sección de bienvenida con una imagen de fondo, presentación de servicios, galería de habitaciones y enlaces de contacto/redes sociales. El diseño es moderno, limpio y optimizado para dispositivos móviles y escritorio. Además, se implementó un formulario de contacto funcional para que los visitantes puedan solicitar información o reservar habitaciones fácilmente.",
    link: "https://providenciavalparaiso.com/",
    github: "https://github.com/Haiverhdz/Providencia-Valparaiso",
    image: "/providencia.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
  {
    title: "Fajas Dila",
    description:
      "Desarrollo de un e-commerce para la venta de fajas, construido con Next.js, Tailwind CSS y CSS. Implementa catálogo de productos, filtrado por categorías, páginas de detalle, carrito de compras, diseño responsive y una experiencia de usuario optimizada. La integración con la pasarela de pagos se encuentra en desarrollo.",
    link: "https://fajasdila.com/",
    github: "https://github.com/Haiverhdz/Fajas-Dila",
    image: "/fajas-dila.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
  {
    title: "RideMed",
    description:
      "Aplicación web desarrollada con Next.js, Tailwind CSS y CSS para ofrecer servicios de transporte privado con conductor. Incluye internacionalización (ES/EN), Progressive Web App (PWA), catálogo de servicios, destinos y formulario de contacto. El desarrollo fue realizado mediante un flujo de trabajo asistido por IA (vibe coding).",
    link: "https://ridemed.onrender.com/es",
    github: "https://github.com/Haiverhdz/RideMed",
    image: "/ridemed.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
  {
    title: "Samy's pet mobile grooming",
    description:
      "Desarrollo de un sitio web con React, Tailwind y CSS nativo para un grooming móvil de mascotas. El sitio incluye una sección de bienvenida con una imagen de fondo, presentación de servicios, galería de trabajos anteriores y enlaces de contacto/redes sociales. El diseño es moderno, limpio y optimizado para dispositivos móviles y escritorio. Además, se implementó un formulario de contacto funcional para que los visitantes puedan solicitar información o reservar citas fácilmente donde al poner sus datos quedan registrados en Firebase, ademas se agrega ReactG4 Analytics para medir el tráfico del sitio y el comportamiento de los usuarios, lo que permite optimizar la experiencia y mejorar la conversión de visitantes a clientes. El proyecto se hace en equipo con un amigo, yo me encargue del frontend y el diseño, mientras que el se encargo del backend y la integración con Firebase.",
      link: "https://www.samyspetsmobilegrooming.com/",
      github: "https://github.com/camilogc04/samys-pet-app",
    image: "/samys.webp",
    tags: [TAGS.REACT, TAGS.CSS, TAGS.TAILWIND, TAGS.VITE, TAGS.JAVASCRIPT],
  },
  {
    title: "Hana Beauty",
    description:
      "Desarrollo de un sitio web con Nexts.js y Tailwind CSS para una clienta que tiene servicios personales de make-up, peinados y asesoría de imagen. El sitio incluye una sección de bienvenida con una imagen de fondo, presentación de servicios, galería de trabajos anteriores y enlaces de contacto/redes sociales. El diseño es moderno, limpio y optimizado para dispositivos móviles y escritorio. Además, se implementó un formulario de contacto funcional para que los visitantes puedan solicitar información o reservar citas fácilmente. En algunas secciones se utilizó Claude como vibe coding para generar contenido dinámico y mejorar la experiencia del usuario.",
    link: "https://www.hanabeauty.com.co/",
    github: "https://github.com/Haiverhdz/Hana-Beauty",
    image: "/hana.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },
  {
    title: "Pets Adoption",
    description:
      "Sitio web de simulación de una fundación de mascotas, desarrollada con Next.js y Tailwind, muestra las mascotas disponibles para adoptar, formulario para solicitar la adopción, en el backend se muestra la solicitud por gmail y en la ruta /dashborad, puedes registrarte e iniciar sesión.",
    link: "https://petadoptions.xyz/",
    github: "https://github.com/Haiverhdz/PetAdoption",
    image: "/petadoption.png",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.JAVASCRIPT],
  },

  {
    title: "Contables ECG",
    description:
      "Desarrollo de un sitio web corporativo responsivo para una firma contable, creado con Astro y Tailwind CSS. Incluye sección de bienvenida con imagen de fondo, presentación de servicios, calendario tributario y enlaces de contacto/redes sociales. Diseñado para ofrecer una experiencia rápida, clara y optimizada en dispositivos móviles y escritorio.",
    link: "https://www.contablesecg.com/",
    github: "https://github.com/Haiverhdz/contables-ECG",
    image: "/ecg.webp",
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.JAVASCRIPT ],
  },
]
---
<div id="projects-container" class="flex flex-col gap-y-16">
  {
    PROJECTS.map(
      ({ image, title, description, tags, link, github }, index) => (
        <article
          data-project
          data-hidden={index >= 3}
          class={`project flex flex-col space-x-0 space-y-8 group transition-all duration-500 ease-in-out md:flex-row md:space-x-8 md:space-y-0 ${
            index >= 4 ? "hidden opacity-0" : ""
          }`}
        >
          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <a href={link} target="_blank" rel="noopener noreferrer">
                <img
                  alt={title}
                  class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                  loading="lazy"
                  src={image}
                />
              </a>
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-2 mb-4">
              {tags.map((tag) => (
                <span
                  class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 border border-transparent dark:border-white/10 dark:bg-white/10 dark:text-white`}
                >
                  <tag.icon class="size-5 text-white dark:text-white" />
                  {tag.name}
                </span>
              ))}
            </div>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}

              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </article>
      )
    )
  }
</div>

{
  PROJECTS.length > 4 && (
    <div class="mt-12 flex justify-center">
      <button
        id="toggle-projects"
        class="rounded-full border border-gray-300 px-8 py-3 font-semibold transition-all duration-300 hover:scale-105 hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800"
      >
        Ver más proyectos
      </button>
    </div>
  )
}
<script>
  const button = document.querySelector("#toggle-projects");

  if (button) {
    let expanded = false;

    const projects = document.querySelectorAll("[data-project]");

    button.addEventListener("click", () => {
      expanded = !expanded;

      projects.forEach((project) => {
        if (project.dataset.hidden === "true") {
          project.classList.toggle("hidden");
          project.classList.toggle("opacity-0");
        }
      });

      button.textContent = expanded
        ? "Ver menos proyectos"
        : "Ver más proyectos";

      if (!expanded) {
        document
          .getElementById("projects-container")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
      }
    });
  }
</script>